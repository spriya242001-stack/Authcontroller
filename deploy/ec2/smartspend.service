[Unit]
Description=SmartSpend backend
After=network-online.target mariadb.service
Wants=network-online.target

[Service]
Type=simple
User=ec2-user
Group=ec2-user
WorkingDirectory=/home/ec2-user
ExecStart=/usr/bin/java -jar /home/ec2-user/Smartspend-backend-0.0.1-SNAPSHOT.jar --spring.config.additional-location=file:/etc/smartspend/application.properties
Restart=on-failure
RestartSec=5
TimeoutStopSec=30
SuccessExitStatus=143
UMask=0077
NoNewPrivileges=true
PrivateTmp=true

[Install]
WantedBy=multi-user.target
